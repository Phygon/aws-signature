{
  "name": "aws-signature",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phygon/aws-signature.git"
  },
  "devDependencies": {
    "@saibotsivad/aws-sig-v4-test-suite": "^2.0.4",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "description": "A Node.js and TypeScript library for creating AWS Signature Version 4 signed requests and presigned URLs",
  "files": [
    "dist"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "tsdown": {
    "entry": ["./src/index.ts"],
    "outDir": "dist",
    "format": ["esm"],
    "dts": true,
    "sourcemap": true,
    "clean": true
  }
}
